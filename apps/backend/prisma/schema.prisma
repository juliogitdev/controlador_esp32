generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SourceKind {
  presence
  temperature
  humidity
  voltage
  current
  climate_state
}

enum ReadingStatus {
  ok
  unavailable
}

enum ReadingOrigin {
  hardware
  simulated
}

enum CommandStatus {
  pending
  delivered
  capturing
  completed
  failed
  rejected
  unknown_after_restart
  expired
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  rooms     Room[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("departments")
}

model Room {
  id           String         @id @default(uuid()) @db.Uuid
  subjectId    String         @unique @map("subject_id") @db.VarChar(64)
  name         String         @db.VarChar(100)
  departmentId String         @map("department_id") @db.Uuid
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  devices      Device[]
  sources      SensorSource[]
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([departmentId, name])
  @@map("rooms")
}

model Device {
  id             String    @id @db.VarChar(64)
  name           String    @db.VarChar(100)
  tokenHash      String    @map("token_hash") @db.Char(64)
  enabled        Boolean   @default(true)
  roomId         String?   @map("room_id") @db.Uuid
  room           Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  firmwareVersion String?  @map("firmware_version") @db.VarChar(32)
  lastBootId     String?   @map("last_boot_id") @db.VarChar(64)
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(3)
  intervalMs     Int       @default(5000) @map("interval_ms")
  lastSequence   BigInt    @default(0) @map("last_sequence")
  telemetry      Json?
  commands       Command[]
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("devices")
}

model SensorSource {
  id        String       @id @db.VarChar(64)
  name      String       @db.VarChar(100)
  kind      SourceKind
  tokenHash String       @map("token_hash") @db.Char(64)
  enabled   Boolean      @default(true)
  roomId    String       @map("room_id") @db.Uuid
  room      Room         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  readings  Reading[]
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sensor_sources")
}

model Reading {
  id          String         @id @default(uuid()) @db.Uuid
  eventId     String         @unique @map("event_id") @db.VarChar(64)
  sourceId    String         @map("source_id") @db.VarChar(64)
  source      SensorSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  observedAt  DateTime       @map("observed_at") @db.Timestamptz(3)
  receivedAt  DateTime       @default(now()) @map("received_at") @db.Timestamptz(3)
  validUntil  DateTime       @map("valid_until") @db.Timestamptz(3)
  value       Json?
  unit        String         @db.VarChar(24)
  status      ReadingStatus
  origin      ReadingOrigin

  @@index([sourceId, observedAt(sort: Desc)])
  @@map("readings")
}

model Command {
  id          String        @id @db.VarChar(64)
  sequence    BigInt
  deviceId    String        @map("device_id") @db.VarChar(64)
  device      Device        @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  type        String        @db.VarChar(48)
  payload     Json
  status      CommandStatus @default(pending)
  bootId      String?       @map("boot_id") @db.VarChar(64)
  result      Json?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(3)
  deliveredAt DateTime?     @map("delivered_at") @db.Timestamptz(3)
  completedAt DateTime?     @map("completed_at") @db.Timestamptz(3)

  @@unique([deviceId, sequence])
  @@index([deviceId, status, sequence])
  @@map("commands")
}
